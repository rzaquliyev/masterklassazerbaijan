{% extends "layouts/base.njk" %}

{% block title %}{{ t.rengleme.title }} — {{ t.siteName }}{% endblock %}
{% block meta_description %}{{ t.rengleme.lead }}{% endblock %}
{% block extra_css %}<link rel="stylesheet" href="/css/rengleme.css?v={{ assetV }}">{% endblock %}

{% block content %}
<section class="container page-head">
  <div style="display:flex; justify-content:space-between; align-items:center;">
    <a class="back-link" href="/{{ lang }}/oyun-parki">← {{ t.oyunParki.title }}</a>
    <span class="chip-solid" style="background:var(--butter);" id="rg-progress">0 / 0 {{ t.rengleme.progressLabel }}</span>
  </div>
  <h1 style="margin-top:14px;">{{ t.rengleme.title }}</h1>
  <p class="page-lead">{{ t.rengleme.lead }}</p>
</section>

<section class="container" style="margin-top:6px;">
  <div class="rg-thumbs" id="rg-thumbs" role="group" aria-label="{{ t.rengleme.title }}"></div>

  <div class="rg-canvas-wrap">
    <svg id="rg-canvas" viewBox="0 0 320 320" role="img" aria-label="{{ t.rengleme.title }}"></svg>
    <div class="rg-finished" id="rg-finished" hidden>
      <span class="rg-finished-title">{{ t.rengleme.finishedTitle }}</span>
      <button type="button" class="btn-secondary" id="rg-download">{{ t.rengleme.download }}</button>
    </div>
  </div>

  <div class="rg-palette" id="rg-palette" role="group" aria-label="Rəng palitrası"></div>

  <div class="rg-tools">
    <button type="button" class="btn-secondary" id="rg-undo">↶ {{ t.rengleme.undo }}</button>
    <button type="button" class="btn-secondary" style="background:var(--butter);" id="rg-sample">{{ t.rengleme.sampleBtn }}</button>
    <button type="button" class="btn-dark" id="rg-clear">{{ t.rengleme.clearBtn }}</button>
  </div>

  <div class="sample-notice" style="margin-top:16px; background:var(--white); border-radius:var(--radius-md); padding:14px 16px; box-shadow:0 4px 0 var(--card-shadow);">{{ t.rengleme.privacyNote }}</div>
</section>
{% endblock %}

{% block extra_js %}
<script type="application/json" id="rg-i18n">{{ {
  "pictureNames": t.rengleme.pictureNames,
  "levels": t.rengleme.levels,
  "eraserLabel": t.rengleme.eraserLabel,
  "progressLabel": t.rengleme.progressLabel
} | dump | safe }}</script>
<script src="/js/rengleme-data.js?v={{ assetV }}" defer></script>
<script src="/js/rengleme.js?v={{ assetV }}" defer></script>
{% endblock %}
