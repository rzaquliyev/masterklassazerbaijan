<!doctype html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}{{ t.siteName }}{% endblock %}</title>
<meta name="description" content="{% block meta_description %}{{ t.home.metaDescription }}{% endblock %}">
<link rel="canonical" href="/{{ lang }}{{ currentPath or '' }}">
{% for l in supportedLangs %}
<link rel="alternate" hreflang="{{ l }}" href="/{{ l }}{{ currentPath or '' }}">
{% endfor %}
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<meta name="theme-color" content="#FFF4E2">
<link rel="stylesheet" href="/css/fonts.css?v={{ assetV }}">
<link rel="stylesheet" href="/css/tokens.css?v={{ assetV }}">
<link rel="stylesheet" href="/css/site.css?v={{ assetV }}">
<link rel="stylesheet" href="/css/motion.css?v={{ assetV }}">
{% block extra_css %}{% endblock %}
</head>
<body class="{% block body_class %}{% endblock %}">
{% if holidayBanner %}
<div class="holiday-banner" style="background:var(--{{ holidayBanner.colorToken }});">{{ holidayBanner.text }}</div>
{% endif %}
<a class="skip-link" href="#main">{{ t.nav.skip }}</a>

<header class="container topbar">
  <a class="logo" href="/{{ lang }}/" aria-label="{{ t.siteName }}">
    <span class="logo-dot clay" aria-hidden="true"></span><span class="logo-text-full" aria-hidden="true">{{ t.siteName }}</span><span class="logo-text-short" aria-hidden="true">{{ t.siteNameShort }}</span>
  </a>
  <nav class="main-nav" aria-label="{{ t.nav.mainNav }}">
    <a href="/{{ lang }}/#tour">{{ t.nav.catalog }}</a>
    <a href="/{{ lang }}/teqvim">{{ t.nav.teqvim }}</a>
    <a href="/{{ lang }}/suallar">{{ t.nav.about }}</a>
  </nav>
  <div class="topbar-right">
    <div class="lang-switch" aria-label="{{ t.nav.langSwitch }}">
      {% for l in supportedLangs %}
      <a href="/{{ l }}{{ currentPath or '' }}" aria-current="{{ 'true' if l == lang else 'false' }}">{{ l | upper }}</a>
      {% endfor %}
    </div>
    <a class="btn-nav" href="/{{ lang }}/teqvim">{{ t.nav.register }}</a>
    <button id="menu-btn" class="menu-btn" type="button" aria-expanded="false" aria-controls="menu-overlay" aria-label="{{ t.nav.menuTitle }}">≡</button>
  </div>
</header>

<main id="main">
{% block content %}{% endblock %}
</main>

<footer class="site-footer">
  <div class="foot-sky" aria-hidden="true" data-anim>
    {% for st in [[7,22],[19,58],[31,16],[46,44],[58,14],[71,60],[88,30]] %}<i class="foot-star" style="left:{{ st[0] }}%; top:{{ st[1] }}px; --k:{{ loop.index0 }};"></i>{% endfor %}
    <span class="foot-moon"></span>
    <div class="foot-skyline">
      {% for b in [['orange',30,58,[1,0,0,1]],['blue',38,76,[0,1,0,1,1,0]],['sun',28,50,[1,0]],['green',36,68,[0,1,1,0]],['pink',26,46,[0,1]],['orange',32,60,[0,1,0,0]]] %}
      <span class="foot-bld" style="--w:{{ b[1] }}px; --h:{{ b[2] }}px; --c:var(--{{ b[0] }});">
        <span class="foot-roof"></span>
        <span class="foot-body">{% set bi = loop.index0 %}{% for w in b[3] %}<i class="foot-win {{ 'on' if w == 1 }}" style="--k:{{ bi * 2 + loop.index0 }};"></i>{% endfor %}</span>
      </span>
      {% endfor %}
    </div>
    <span class="foot-street"></span>
  </div>

  <div class="container foot-cols">
    <div>
      <div class="foot-title">{{ t.footer.title }}</div>
      <div class="foot-cta">
        <a class="btn-primary" href="/{{ lang }}/teqvim">{{ t.footer.cta }}</a>
        <a class="btn-primary foot-wa" href="https://wa.me/994558199901" target="_blank" rel="noopener">{{ t.footer.whatsapp }}</a>
      </div>
    </div>
    <nav aria-label="{{ t.footer.placesTitle }}">
      <div class="foot-col-title">{{ t.footer.placesTitle }}</div>
      <ul class="foot-places">
        {% for p in t.places %}
        <li><a href="{{ p.href | replace('{lang}', lang) }}"><span class="dot" style="background:{{ p.color }};" aria-hidden="true"></span>{{ p.what }} <span class="foot-place">— {{ p.place }}</span></a></li>
        {% endfor %}
      </ul>
    </nav>
    <div>
      <div class="foot-col-title">{{ t.footer.contactTitle }}</div>
      <address class="foot-contact">
        <strong>{{ t.elaqe.address }}</strong>
        <a href="tel:+994558199901">+994 55 819 99 01</a>
        <span>{{ t.elaqe.hoursLabel }}: {{ t.elaqe.hours }}</span>
        <span class="foot-contact-links">
          <a href="https://www.google.com/maps/search/?api=1&query={{ t.elaqe.address | urlencode }}" target="_blank" rel="noopener">{{ t.elaqe.mapOpen }} →</a>
          <a href="https://instagram.com/masterklassazerbaijan" target="_blank" rel="noopener">Instagram →</a>
        </span>
      </address>
    </div>
  </div>

  <div class="container foot-legal">
    <span>© {{ currentYear }} {{ t.siteName }} — {{ t.footer.rights }}</span>
    <span><a href="/{{ lang }}/mexfilik">{{ t.footer.privacy }}</a> · {{ t.footer.sampleNotice }}</span>
  </div>
</footer>

<div id="menu-overlay" class="menu-overlay" hidden role="dialog" aria-modal="true" aria-label="{{ t.nav.menuTitle }}">
  <div class="menu-panel">
    <div class="menu-panel-head">
      <span class="menu-panel-title">{{ t.nav.menuTitle }}</span>
      <button id="menu-close" class="menu-close" type="button" aria-label="{{ t.nav.menuClose }}">×</button>
    </div>
    <ul class="menu-list">
      {% for p in t.places %}
      <li><a href="{{ p.href | replace('{lang}', lang) }}"><span class="dot" style="background:{{ p.color }};" aria-hidden="true"></span>{{ p.what }}<span class="place">{{ p.place }}</span></a></li>
      {% endfor %}
    </ul>
  </div>
</div>

<script src="/js/site.js?v={{ assetV }}" defer></script>
<script src="/js/motion.js?v={{ assetV }}" defer></script>
{% block extra_js %}{% endblock %}
</body>
</html>
