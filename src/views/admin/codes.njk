{% extends "admin/layout.njk" %}
{% block title %}Endirim kodları{% endblock %}
{% block content %}
<h1 class="admin-h1">Endirim kodları</h1>
{% if errors %}<div class="admin-alert error">{{ errors.formErrors[0] if errors.formErrors and errors.formErrors.length else 'Formu yoxlayın — sahələrdən biri səhvdir.' }}</div>{% endif %}

<div class="admin-card" style="max-width:480px;">
  <h2 class="admin-h2">Əl ilə kod yarat</h2>
  <p style="font-size:.82rem; color:var(--night-2); margin-top:-6px;">Referral/gizlənqaç kodları avtomatik yaradılır — bu, xüsusi hal üçün əl ilə kod yaratmaq üçündür.</p>
  <form method="post" action="/admin/kodlar">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
    <div class="admin-field"><label for="percent">Endirim faizi</label><input type="number" id="percent" name="percent" min="1" max="100" required value="10"></div>
    <div class="admin-field"><label for="ownerPhone">Sahibin telefonu (ixtiyari — mövcud müştəri olmalıdır)</label><input type="tel" id="ownerPhone" name="ownerPhone" placeholder="+994 __ ___ __ __"></div>
    <div class="admin-field"><label for="expiresInDays">Neçə gün etibarlıdır (ixtiyari, boş = müddətsiz)</label><input type="number" id="expiresInDays" name="expiresInDays" min="1" max="3650" placeholder="90"></div>
    <button type="submit" class="admin-btn">Yarat</button>
  </form>
</div>

<div class="admin-card">
  <div class="admin-table-wrap">
  <table class="admin-table">
    <thead><tr><th>Kod</th><th>Tip</th><th>Sahib</th><th>Faiz</th><th>Status</th><th>Bitmə tarixi</th><th>İstifadə edən</th><th></th></tr></thead>
    <tbody>
      {% for c in list %}
      <tr>
        <td class="admin-td-tight"><code>{{ c.code }}</code></td>
        <td class="admin-td-tight">{{ c.type }}</td>
        <td class="admin-td-tight">{{ c.owner_name or '—' }}{% if c.owner_phone %}<br><span style="color:var(--night-2); font-size:.78rem;">{{ c.owner_phone }}</span>{% endif %}</td>
        <td class="admin-td-tight">{{ c.percent }}%</td>
        <td class="admin-td-tight"><span class="admin-badge {{ 'confirmed' if c.status == 'active' else 'cancelled' }}">{{ c.status }}</span></td>
        <td class="admin-td-tight">{{ c.expires_at | formatDateOnlyAz if c.expires_at else '—' }}</td>
        <td class="admin-td-tight">{{ c.redeemed_by_name or '—' }}</td>
        <td class="admin-td-tight">
          {% if c.status == 'active' %}
          <form method="post" action="/admin/kodlar/{{ c.id }}/revoke" data-confirm="Bu kod ləğv edilsin?" class="admin-row-form">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
            <button type="submit" class="admin-btn danger small">Ləğv et</button>
          </form>
          {% endif %}
        </td>
      </tr>
      {% else %}
      <tr><td colspan="8">Hələ kod yoxdur.</td></tr>
      {% endfor %}
    </tbody>
  </table>
  </div>
</div>
{% endblock %}
