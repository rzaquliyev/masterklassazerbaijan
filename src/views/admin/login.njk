{% extends "admin/layout.njk" %}
{% block title %}Giriş{% endblock %}
{% block content %}
<div class="admin-card admin-login-card">
  <h1 class="admin-h1">Admin girişi</h1>
  {% if error %}<div class="admin-alert error">{{ error }}</div>{% endif %}
  <form method="post" action="/admin/login">
    <input type="hidden" name="next" value="{{ next }}">
    <div class="admin-field">
      <label for="email">E-poçt</label>
      <input type="email" id="email" name="email" required autofocus>
    </div>
    <div class="admin-field">
      <label for="password">Parol</label>
      <input type="password" id="password" name="password" required>
    </div>
    <button type="submit" class="admin-btn" style="width:100%;">Daxil ol</button>
  </form>
</div>
{% endblock %}
