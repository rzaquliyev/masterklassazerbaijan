{% extends "admin/layout.njk" %}
{% block title %}İstifadəçilər{% endblock %}
{% block content %}
<h1 class="admin-h1">Admin istifadəçiləri</h1>

<div class="admin-card">
  <div class="admin-table-wrap">
  <table class="admin-table">
    <thead><tr><th>E-poçt</th><th>Rol</th><th>Yaradılıb</th></tr></thead>
    <tbody>
      {% for u in list %}
      <tr><td>{{ u.email }}</td><td class="admin-td-tight"><span class="admin-badge {{ u.role }}">{{ u.role }}</span></td><td class="admin-td-tight">{{ u.created_at | formatDateAz }}</td></tr>
      {% endfor %}
    </tbody>
  </table>
  </div>
</div>

<div class="admin-card" style="max-width:440px;">
  <h2 class="admin-h2">Yeni istifadəçi əlavə et</h2>
  {% if errors %}<div class="admin-alert error">{{ errors.formErrors[0] if errors.formErrors and errors.formErrors[0] else 'Formu yoxlayın.' }}</div>{% endif %}
  <form method="post" action="/admin/users">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
    <div class="admin-field"><label for="email">E-poçt</label><input type="email" id="email" name="email" required></div>
    <div class="admin-field"><label for="password">Parol (ən azı 10 simvol)</label><input type="password" id="password" name="password" minlength="10" required></div>
    <div class="admin-field">
      <label for="role">Rol</label>
      <select id="role" name="role">
        <option value="staff">staff (bronlar, iştirak)</option>
        <option value="owner">owner (hər şey, export, silmə)</option>
      </select>
    </div>
    <button type="submit" class="admin-btn">Yarat</button>
  </form>
</div>
{% endblock %}
