{% extends "admin/layout.njk" %}
{% block title %}Suallar{% endblock %}
{% block content %}
<h1 class="admin-h1">Valideyn sualları (FAQ)</h1>
{% if errors %}<div class="admin-alert error">Formu yoxlayın — sahələrdən biri səhvdir.</div>{% endif %}

{% set tabLabels = { q: "Qeydiyyat", o: "Ödəniş", t: "Təhlükəsizlik", g: "Gün özü" } %}

<div class="admin-card">
  <div class="admin-table-wrap">
  <table class="admin-table">
    <thead><tr><th>Bölmə</th><th>Sual</th><th>Cavab</th><th>Sıra</th><th></th></tr></thead>
    <tbody>
      {% for item in list %}
      <tr>
        <td colspan="5" style="padding:0;">
          <form method="post" action="/admin/suallar-idare/{{ item.id }}" style="display:flex; gap:8px; align-items:flex-start; padding:9px 10px; flex-wrap:wrap;">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
            <select name="tab" style="width:140px;" title="Bölmə">
              {% for key, label in tabLabels %}<option value="{{ key }}" {{ 'selected' if item.tab == key }}>{{ label }}</option>{% endfor %}
            </select>
            <input type="text" name="question" value="{{ item.question }}" style="width:220px;" title="Sual" required>
            <textarea name="answer" style="width:260px; min-height:38px;" title="Cavab" required>{{ item.answer }}</textarea>
            <input type="number" name="sortOrder" value="{{ item.sort_order }}" min="0" max="999" style="width:60px;" title="Sıra" required>
            <button type="submit" class="admin-btn small">Yadda saxla</button>
          </form>
          <form method="post" action="/admin/suallar-idare/{{ item.id }}/delete" data-confirm="Bu sual silinsin?" style="padding:0 10px 10px;">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
            <button type="submit" class="admin-btn danger small">Sil</button>
          </form>
        </td>
      </tr>
      {% else %}
      <tr><td colspan="5">Hələ sual yoxdur.</td></tr>
      {% endfor %}
    </tbody>
  </table>
  </div>
</div>

<div class="admin-card" style="max-width:480px;">
  <h2 class="admin-h2">Yeni sual əlavə et</h2>
  <form method="post" action="/admin/suallar-idare">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
    <div class="admin-field">
      <label for="newTab">Bölmə</label>
      <select id="newTab" name="tab" required>
        {% for key, label in tabLabels %}<option value="{{ key }}">{{ label }}</option>{% endfor %}
      </select>
    </div>
    <div class="admin-field"><label for="newQuestion">Sual</label><input type="text" id="newQuestion" name="question" required maxlength="300"></div>
    <div class="admin-field"><label for="newAnswer">Cavab</label><textarea id="newAnswer" name="answer" required></textarea></div>
    <div class="admin-field"><label for="newSort">Sıra</label><input type="number" id="newSort" name="sortOrder" min="0" max="999" value="{{ list.length }}" required></div>
    <button type="submit" class="admin-btn">Əlavə et</button>
  </form>
</div>
{% endblock %}
