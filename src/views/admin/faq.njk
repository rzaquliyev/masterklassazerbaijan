{% extends "admin/layout.njk" %}
{% block title %}Suallar{% endblock %}
{% block content %}
<h1 class="admin-h1">Valideyn sualları (FAQ)</h1>
{% if errors %}<div class="admin-alert error">Formu yoxlayın — sahələrdən biri səhvdir.</div>{% endif %}

{% set tabLabels = { q: "Qeydiyyat", o: "Ödəniş", t: "Təhlükəsizlik", g: "Gün özü" } %}

{% for key, label in tabLabels %}
<div class="admin-card">
  <h2 class="admin-h2">{{ label }}</h2>
  <div class="admin-table-wrap">
  <table class="admin-table">
    <thead><tr><th style="width:140px;">Sual</th><th>Cavab</th><th style="width:60px;">Sıra</th><th></th></tr></thead>
    <tbody>
      {% for item in groups[key] %}
      <tr>
        <td colspan="4" style="padding:0;">
          <form method="post" action="/admin/suallar-idare/{{ item.id }}" class="admin-faq-row">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
            <input type="hidden" name="tab" value="{{ item.tab }}">
            <input type="text" name="question" value="{{ item.question }}" required placeholder="Sual" class="admin-faq-q">
            <textarea name="answer" required placeholder="Cavab" class="admin-faq-a">{{ item.answer }}</textarea>
            <input type="number" name="sortOrder" value="{{ item.sort_order }}" min="0" max="999" title="Sıra" class="admin-sort-input">
            <button type="submit" class="admin-btn secondary small">Saxla</button>
          </form>
          <form method="post" action="/admin/suallar-idare/{{ item.id }}/delete" data-confirm="Bu sual silinsin?" class="admin-row-form" style="padding:0 10px 9px;">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
            <button type="submit" class="admin-btn danger small">Sil</button>
          </form>
        </td>
      </tr>
      {% else %}
      <tr><td colspan="4" class="admin-muted">Bu bölmədə hələ sual yoxdur.</td></tr>
      {% endfor %}
    </tbody>
  </table>
  </div>
</div>
{% endfor %}

<div class="admin-card" style="max-width:480px;">
  <h2 class="admin-h2">Yeni sual əlavə et</h2>
  <form method="post" action="/admin/suallar-idare">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
    <div class="admin-field">
      <label for="newTab">Bölmə</label>
      <select id="newTab" name="tab" required>
        {% for key, label in tabLabels %}<option value="{{ key }}">{{ label }}</option>{% endfor %}
      </select>
    </div>
    <div class="admin-field"><label for="newQuestion">Sual</label><input type="text" id="newQuestion" name="question" required maxlength="300"></div>
    <div class="admin-field"><label for="newAnswer">Cavab</label><textarea id="newAnswer" name="answer" required></textarea></div>
    <div class="admin-field"><label for="newSort">Sıra</label><input type="number" id="newSort" name="sortOrder" min="0" max="999" value="0" required></div>
    <button type="submit" class="admin-btn">Əlavə et</button>
  </form>
</div>
{% endblock %}
