{% extends "admin/layout.njk" %}
{% block title %}Bronlar{% endblock %}
{% block content %}
<h1 class="admin-h1">Bronlar</h1>

<form class="admin-filters" method="get" action="/admin/bookings">
  <div class="admin-field" style="margin:0;">
    <label for="q">Axtar (ad, telefon, bilet №)</label>
    <input type="text" id="q" name="q" value="{{ search }}">
  </div>
  <div class="admin-field" style="margin:0;">
    <label for="status">Status</label>
    <select id="status" name="status">
      <option value="" {{ 'selected' if status == '' }}>Hamısı</option>
      {% for s in ['pending','confirmed','attended','cancelled','waitlist'] %}
      <option value="{{ s }}" {{ 'selected' if status == s }}>{{ s }}</option>
      {% endfor %}
    </select>
  </div>
  <button type="submit" class="admin-btn secondary">Filtrlə</button>
</form>

<div class="admin-card">
  <div class="admin-table-wrap">
  <table class="admin-table">
    <thead><tr><th>Bilet №</th><th>Masterklass</th><th>Tarix</th><th>Uşaq</th><th>Valideyn</th><th>Telefon</th><th>Qiymət</th><th>Status</th><th>Qeyd</th><th>Əməliyyat</th></tr></thead>
    <tbody>
      {% for b in list %}
      <tr>
        <td class="admin-td-tight"><strong>{{ b.reference }}</strong></td>
        <td>{{ b.masterclass_title }}</td>
        <td class="admin-td-tight">{{ b.starts_at | formatDateAz }}</td>
        <td>{{ b.child_first_name }}</td>
        <td>{{ b.parent_name }}</td>
        <td class="admin-td-tight">{% if b.phone_e164.startsWith('anon-') %}<span class="admin-muted">anonimləşdirilib</span>{% else %}<a href="tel:{{ b.phone_e164 }}">{{ b.phone_e164 }}</a>{% endif %}</td>
        <td class="admin-td-tight">{{ b.price_azn | formatMoney }}</td>
        <td class="admin-td-tight"><span class="admin-badge {{ b.status }}">{{ b.status }}</span></td>
        <td style="min-width:150px;">
          <form method="post" action="/admin/bookings/{{ b.id }}/notes" style="display:flex; gap:6px;">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
            <input type="text" name="notes" value="{{ b.admin_notes or '' }}" placeholder="qeyd…" style="min-height:34px; font-size:.82rem;">
            <button type="submit" class="admin-btn secondary small" aria-label="Qeydi saxla">✓</button>
          </form>
        </td>
        <td class="admin-td-tight">
          <div style="display:flex; gap:6px;">
          {% if b.status in ['pending','confirmed','waitlist'] %}
          <form method="post" action="/admin/bookings/{{ b.id }}/status" class="admin-row-form" onsubmit="return confirm('Bu bronu ləğv etmək istədiyinizə əminsiniz?');">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
            <input type="hidden" name="status" value="cancelled">
            <button type="submit" class="admin-btn danger small">Ləğv et</button>
          </form>
          {% endif %}
          {% if b.status == 'confirmed' %}
          <form method="post" action="/admin/bookings/{{ b.id }}/status" class="admin-row-form">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
            <input type="hidden" name="status" value="attended">
            <button type="submit" class="admin-btn secondary small">Gəldi ✓</button>
          </form>
          {% endif %}
          </div>
        </td>
      </tr>
      {% else %}
      <tr><td colspan="10">Nəticə yoxdur.</td></tr>
      {% endfor %}
    </tbody>
  </table>
  </div>
</div>
{% endblock %}
