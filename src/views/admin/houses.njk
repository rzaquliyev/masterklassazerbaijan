{% extends "admin/layout.njk" %}
{% block title %}Evlər{% endblock %}
{% block content %}
<h1 class="admin-h1">Evlər</h1>
{% if errors %}<div class="admin-alert error">Formu yoxlayın — sahələrdən biri səhvdir (rəng #RRGGBB formatında, slug yalnız kiçik hərf/rəqəm/tire olmalıdır).</div>{% endif %}

<div class="admin-house-grid">
  {% for h in list %}
  <form method="post" action="/admin/evler/{{ h.id }}" class="admin-house-card" style="--house-color:{{ h.color_hex }};">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
    <div class="admin-house-top">
      <input type="color" name="colorHex" value="{{ h.color_hex }}" class="admin-house-swatch" title="Rəng seç">
      <input type="text" name="name" value="{{ h.name }}" class="admin-house-name" required maxlength="80" aria-label="Ad">
    </div>
    <div class="admin-house-row">
      <input type="text" name="slug" value="{{ h.slug }}" pattern="[a-z0-9-]+" required aria-label="Slug" title="Slug">
      <input type="number" name="sortOrder" value="{{ h.sort_order }}" min="0" max="999" required aria-label="Sıra" title="Sıra">
    </div>
    <div class="admin-house-footer">
      <span class="admin-badge info">{{ h.masterclass_count }} masterklass</span>
      <button type="submit" class="admin-btn small">Yadda saxla</button>
    </div>
  </form>
  {% else %}
  <p>Hələ ev yoxdur.</p>
  {% endfor %}

  <form method="post" action="/admin/evler" class="admin-house-card admin-house-card--new">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
    <h2 class="admin-h2">+ Yeni ev</h2>
    <div class="admin-house-top">
      <input type="color" name="colorHex" value="#E8682A" class="admin-house-swatch" title="Rəng seç">
      <input type="text" name="name" placeholder="Ad" class="admin-house-name" required maxlength="80" aria-label="Ad">
    </div>
    <div class="admin-house-row">
      <input type="text" name="slug" placeholder="slug" pattern="[a-z0-9-]+" required aria-label="Slug" title="Slug (yalnız kiçik hərf/rəqəm/tire)">
      <input type="number" name="sortOrder" value="{{ list.length }}" min="0" max="999" required aria-label="Sıra" title="Sıra">
    </div>
    <div class="admin-house-footer" style="justify-content:flex-end;">
      <button type="submit" class="admin-btn">Yarat</button>
    </div>
  </form>
</div>
{% endblock %}
