{% extends "admin/layout.njk" %}
{% block title %}Evlər{% endblock %}
{% block content %}
<h1 class="admin-h1">Evlər</h1>
{% if errors %}<div class="admin-alert error">Formu yoxlayın — rəng #RRGGBB formatında, slug yalnız kiçik hərf/rəqəm/tire olmalıdır.</div>{% endif %}

<div class="admin-card">
  <div class="admin-table-wrap">
  <table class="admin-table">
    <thead><tr><th></th><th>Ad</th><th>Slug</th><th>Rəng</th><th>Sıra</th><th>Masterklass</th><th></th></tr></thead>
    <tbody>
      {% for h in list %}
      <tr>
        <td colspan="7" style="padding:0;">
          <form method="post" action="/admin/evler/{{ h.id }}" class="admin-house-row">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
            <span class="admin-swatch" style="background:{{ h.color_hex }};" aria-hidden="true"></span>
            <input type="text" name="name" value="{{ h.name }}" required maxlength="80" aria-label="Ad" class="admin-house-name-input">
            <input type="text" name="slug" value="{{ h.slug }}" pattern="[a-z0-9-]+" required aria-label="Slug" title="Slug">
            <input type="text" name="colorHex" value="{{ h.color_hex }}" pattern="#[0-9A-Fa-f]{6}" required aria-label="Rəng" title="#RRGGBB" class="admin-hex-input">
            <input type="number" name="sortOrder" value="{{ h.sort_order }}" min="0" max="999" required aria-label="Sıra" title="Sıra" class="admin-sort-input">
            <span class="admin-badge info">{{ h.masterclass_count }}</span>
            <button type="submit" class="admin-btn secondary small">Yadda saxla</button>
          </form>
        </td>
      </tr>
      {% else %}
      <tr><td colspan="7">Hələ ev yoxdur.</td></tr>
      {% endfor %}
    </tbody>
  </table>
  </div>
</div>

<div class="admin-card" style="max-width:480px;">
  <h2 class="admin-h2">Yeni ev əlavə et</h2>
  <form method="post" action="/admin/evler">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
    <div class="admin-field"><label for="newName">Ad</label><input type="text" id="newName" name="name" required maxlength="80"></div>
    <div class="admin-field"><label for="newSlug">Slug (URL, yalnız kiçik hərf/rəqəm/tire)</label><input type="text" id="newSlug" name="slug" required pattern="[a-z0-9-]+" maxlength="60"></div>
    <div class="admin-field"><label for="newColor">Rəng (#RRGGBB)</label><input type="text" id="newColor" name="colorHex" required pattern="#[0-9A-Fa-f]{6}" placeholder="#E8682A"></div>
    <div class="admin-field"><label for="newSort">Sıra</label><input type="number" id="newSort" name="sortOrder" min="0" max="999" value="{{ list.length }}" required></div>
    <button type="submit" class="admin-btn">Yarat</button>
  </form>
</div>
{% endblock %}
