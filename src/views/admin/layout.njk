<!doctype html>
<html lang="az">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>{% block title %}Admin{% endblock %} — Masterklass Azerbaijan</title>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="/css/tokens.css?v={{ assetV }}">
<link rel="stylesheet" href="/css/admin.css?v={{ assetV }}">
</head>
<body>
<div class="admin-shell {{ 'admin-shell--bare' if not admin }}">
  {% if admin %}
  <nav class="admin-nav">
    <div class="admin-nav-brand">Admin</div>
    <a href="/admin" class="{{ 'is-current' if currentPath == '/admin' }}">İdarə paneli</a>
    <a href="/admin/masterclasses" class="{{ 'is-current' if currentPath.startsWith('/admin/masterclasses') }}">Masterklasslar</a>
    <a href="/admin/bookings" class="{{ 'is-current' if currentPath.startsWith('/admin/bookings') }}">Bronlar</a>
    <a href="/admin/customers" class="{{ 'is-current' if currentPath.startsWith('/admin/customers') }}">Müştərilər</a>
    <a href="/admin/inquiries" class="{{ 'is-current' if currentPath.startsWith('/admin/inquiries') }}">Sorğular</a>
    <a href="/admin/qalereya" class="{{ 'is-current' if currentPath.startsWith('/admin/qalereya') }}">Qalereya</a>
    {% if admin.role == 'owner' %}
    <a href="/admin/users" class="{{ 'is-current' if currentPath.startsWith('/admin/users') }}">İstifadəçilər</a>
    <a href="/admin/audit" class="{{ 'is-current' if currentPath.startsWith('/admin/audit') }}">Jurnal</a>
    <a href="/admin/export/bookings.csv">CSV ixrac</a>
    {% endif %}
    <div class="admin-nav-spacer"></div>
    <span class="admin-nav-user">{{ admin.email }} · {{ admin.role }}</span>
    <form method="post" action="/admin/logout" style="margin:0;">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">
      <button type="submit" class="admin-btn-link">Çıxış</button>
    </form>
  </nav>
  {% endif %}
  <main class="admin-main {{ 'admin-main--bare' if not admin }}">
    {% block content %}{% endblock %}
  </main>
</div>
</body>
</html>
