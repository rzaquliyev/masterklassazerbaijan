{% extends "admin/layout.njk" %}
{% block title %}{{ item.full_name }}{% endblock %}
{% block content %}
<h1 class="admin-h1">{{ item.full_name }}</h1>

<div class="admin-card" style="max-width:560px;">
  <p><strong>Telefon:</strong> {{ item.phone_e164 }}</p>
  <p><strong>Marketinq razılığı:</strong> {{ 'bəli' if item.marketing_consent else 'yox' }}</p>
  <p><strong>Qeydiyyat:</strong> {{ item.created_at | formatDateAz }}</p>
  {% if item.anonymized_at %}<p><span class="admin-badge cancelled">Anonimləşdirilib: {{ item.anonymized_at | formatDateAz }}</span></p>{% endif %}

  <form method="post" action="/admin/customers/{{ item.id }}/notes" style="margin-top:14px;">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
    <div class="admin-field">
      <label for="notes">Daxili qeyd</label>
      <textarea id="notes" name="notes">{{ item.admin_notes or '' }}</textarea>
    </div>
    <button type="submit" class="admin-btn secondary">Qeydi yadda saxla</button>
  </form>

  {% if admin.role == 'owner' and not item.anonymized_at %}
  <form method="post" action="/admin/customers/{{ item.id }}/anonymize" style="margin-top:14px;"
    onsubmit="return confirm('Bu müştərinin bütün şəxsi məlumatları (ad, telefon) silinəcək. Bu geri qaytarıla bilməz. Davam edilsin?');">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
    <button type="submit" class="admin-btn danger">Müştərini anonimləşdir (sil)</button>
  </form>
  {% endif %}
</div>

<div class="admin-card">
  <h2 class="admin-h2">Bronları</h2>
  <table class="admin-table">
    <thead><tr><th>Bilet №</th><th>Status</th><th>Qiymət</th><th>Tarix</th></tr></thead>
    <tbody>
      {% for b in bookings %}
      <tr>
        <td>{{ b.reference }}</td>
        <td><span class="admin-badge {{ b.status }}">{{ b.status }}</span></td>
        <td>{{ b.price_azn | formatMoney }}</td>
        <td>{{ b.created_at | formatDateAz }}</td>
      </tr>
      {% else %}
      <tr><td colspan="4">Bron yoxdur.</td></tr>
      {% endfor %}
    </tbody>
  </table>
</div>
<a href="/admin/customers">← Müştərilərə qayıt</a>
{% endblock %}
