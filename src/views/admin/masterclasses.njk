{% extends "admin/layout.njk" %}
{% block title %}Masterklasslar{% endblock %}
{% block content %}
<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:18px;">
  <h1 class="admin-h1" style="margin:0;">Masterklasslar</h1>
  <a class="admin-btn" href="/admin/masterclasses/new">+ Yeni masterklass</a>
</div>

<div class="admin-card">
  <div class="admin-table-wrap">
  <table class="admin-table">
    <thead><tr><th>Başlıq</th><th>Ev</th><th>Yaş</th><th>Gələcək seans</th><th>Status</th><th>Əməliyyat</th></tr></thead>
    <tbody>
      {% for m in list %}
      <tr>
        <td><a href="/admin/masterclasses/{{ m.id }}">{{ m.title }}</a></td>
        <td class="admin-td-tight">{{ m.house_name or '—' }}</td>
        <td class="admin-td-tight">{{ m.age_min }}–{{ m.age_max }}</td>
        <td class="admin-td-tight">{{ m.upcoming_session_count }}</td>
        <td class="admin-td-tight"><span class="admin-badge {{ 'confirmed' if m.is_published else 'cancelled' }}">{{ 'Dərc olunub' if m.is_published else 'Gizli' }}</span></td>
        <td class="admin-td-tight">
          <form method="post" action="/admin/masterclasses/{{ m.id }}/publish" class="admin-row-form">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
            <input type="hidden" name="published" value="{{ '0' if m.is_published else '1' }}">
            <button type="submit" class="admin-btn secondary small">{{ 'Gizlət' if m.is_published else 'Dərc et' }}</button>
          </form>
        </td>
      </tr>
      {% else %}
      <tr><td colspan="6">Hələ masterklass yoxdur.</td></tr>
      {% endfor %}
    </tbody>
  </table>
  </div>
</div>
{% endblock %}
