{% extends "admin/layout.njk" %}
{% block title %}Audit jurnalı{% endblock %}
{% block content %}
<h1 class="admin-h1">Audit jurnalı</h1>
<div class="admin-card">
  <div class="admin-table-wrap">
  <table class="admin-table">
    <thead><tr><th>Tarix</th><th>İstifadəçi</th><th>Əməliyyat</th><th>Hədəf</th></tr></thead>
    <tbody>
      {% for a in list %}
      <tr>
        <td class="admin-td-tight">{{ a.created_at | formatDateAz }}</td>
        <td class="admin-td-tight">{{ a.admin_email or '—' }}</td>
        <td class="admin-td-tight"><span class="admin-badge info">{{ a.action }}</span></td>
        <td>{% if a.target_table %}<span title="{{ a.target_id }}">{{ a.target_table }}: {{ a.target_id.slice(0, 8) }}…</span>{% endif %}</td>
      </tr>
      {% else %}
      <tr><td colspan="4">Qeyd yoxdur.</td></tr>
      {% endfor %}
    </tbody>
  </table>
  </div>
</div>
{% endblock %}
