{% extends "layouts/base.njk" %}

{% block title %}{{ t.elaqe.title | replace('\n',' ') }} — {{ t.siteName }}{% endblock %}
{% block meta_description %}{{ t.elaqe.lead }}{% endblock %}

{% block content %}
<section class="container page-head">
  <h1 style="white-space:pre-line;">{{ t.elaqe.title }}</h1>
  <p class="page-lead">{{ t.elaqe.lead }}</p>

  {% if sent %}
  <div class="callout on-green" style="margin-top:20px;">
    <div style="font-family:var(--font-display); font-weight:700; font-size:1.3rem;">{{ t.elaqe.sentTitle }}</div>
    <div style="margin-top:6px; font-weight:700;">{{ t.elaqe.sentLead }}</div>
    <a class="btn-secondary" style="margin-top:14px; display:inline-flex;" href="/{{ lang }}/elaqe">{{ t.elaqe.sendAgain }}</a>
  </div>
  {% else %}
  {% if error %}<div class="form-alert error" style="margin-top:16px;">{{ t.elaqe.error }}</div>{% endif %}
  <form method="post" action="/{{ lang }}/elaqe" style="margin-top:20px; max-width:480px;">
    <input type="text" name="website" class="visually-hidden" tabindex="-1" autocomplete="off" aria-hidden="true">
    <div class="field"><label for="elaqe-name">{{ t.elaqe.formName }}</label><input type="text" id="elaqe-name" name="name" required value="{{ formValues.name or '' }}"></div>
    <div class="field"><label for="elaqe-phone">{{ t.elaqe.formPhone }}</label><input type="tel" id="elaqe-phone" name="phone" required value="{{ formValues.phone or '' }}"></div>
    <div class="field"><label for="elaqe-message">{{ t.elaqe.formMessage }}</label><textarea id="elaqe-message" name="message" required rows="4">{{ formValues.message or '' }}</textarea></div>
    <button type="submit" class="btn-primary" style="width:100%;">{{ t.elaqe.send }}</button>
  </form>
  {% endif %}

  <div class="card-grid cols-2" style="margin-top:30px;">
    <div class="trust-card" style="grid-column:1/-1;"><div style="font-size:.8rem; font-weight:800; color:var(--night-2);">{{ t.elaqe.addressLabel }}</div><div style="font-weight:800; margin-top:2px;">{{ t.elaqe.address }}</div></div>
    <div class="trust-card"><div style="font-size:.8rem; font-weight:800; color:var(--night-2);">{{ t.elaqe.hoursLabel }}</div><div style="font-weight:800; margin-top:2px;">{{ t.elaqe.hours }}</div></div>
    <div class="trust-card"><div style="font-size:.8rem; font-weight:800; color:var(--night-2);">{{ t.elaqe.phoneLabel }}</div><a href="tel:+994000000000" style="font-weight:800; margin-top:2px; display:block;">+994 00 000 00 00</a></div>
    <a class="btn-primary" style="background:var(--green); box-shadow:inset -4px -5px 0 rgba(0,0,0,.12), 0 5px 0 var(--green-deep);" href="https://wa.me/994000000000" target="_blank" rel="noopener">WhatsApp</a>
    <a class="btn-primary" style="background:var(--pink); box-shadow:inset -4px -5px 0 rgba(0,0,0,.12), 0 5px 0 var(--pink-deep);" href="https://instagram.com/masterklassazerbaijan" target="_blank" rel="noopener">Instagram</a>
  </div>

  <a class="btn-secondary" style="margin-top:16px; display:inline-flex;" href="https://www.google.com/maps" target="_blank" rel="noopener">{{ t.elaqe.mapOpen }}</a>
</section>
{% endblock %}
