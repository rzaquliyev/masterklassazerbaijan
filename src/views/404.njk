{% extends "layouts/base.njk" %}

{% block title %}{{ t.notFound.title }} — {{ t.siteName }}{% endblock %}
{% block meta_description %}{{ t.notFound.lead }}{% endblock %}
{% block extra_css %}<link rel="stylesheet" href="/css/404.css?v={{ assetV }}">{% endblock %}

{% block content %}
<section class="container not-found">
  <div class="not-found-road" aria-hidden="true">
    <svg viewBox="0 0 200 60"><path d="M10 50 C 60 10, 140 10, 190 50" fill="none" stroke="var(--card-shadow)" stroke-width="10" stroke-linecap="round"></path><path d="M10 50 C 60 10, 140 10, 190 50" fill="none" stroke="var(--orange)" stroke-width="3" stroke-dasharray="10 10"></path></svg>
  </div>
  <h1 class="center-text">{{ t.notFound.title }}</h1>
  <p class="page-lead center-text">{{ t.notFound.lead }}</p>
  <a class="btn-primary" style="margin:0 auto; display:flex; width:fit-content;" href="/{{ lang or 'az' }}/">{{ t.notFound.cta }}</a>
</section>
{% endblock %}
