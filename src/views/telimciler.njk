{% extends "layouts/base.njk" %}

{% block title %}{{ t.telimciler.title | replace('\n',' ') }} — {{ t.siteName }}{% endblock %}
{% block meta_description %}{{ t.telimciler.lead }}{% endblock %}
{% block extra_css %}<link rel="stylesheet" href="/css/telimciler.css?v={{ assetV }}">{% endblock %}

{% block content %}
<section class="container page-head">
  <h1 style="white-space:pre-line;">{{ t.telimciler.title }}</h1>
  <p class="page-lead">{{ t.telimciler.lead }}</p>
</section>

<section class="container" style="margin-top:26px;">
  {% if instructors.length == 0 %}
  <p>{{ t.telimciler.empty }}</p>
  {% else %}
  <div class="stack">
    {% for ins in instructors %}
    <div class="flip-card instructor-card">
      <div class="flip-card-inner">
        <div class="flip-face instructor-face-front">
          <div class="foto-placeholder" style="min-width:76px; height:76px; border-radius:50%;">[FOTO]</div>
          <div class="instructor-info">
            <span class="chip-solid" style="background:{{ ins.house_color }};">{{ ins.house_name }}</span>
            <div class="instructor-name">{{ ins.name }}</div>
          </div>
          <button type="button" class="btn-secondary" data-flip-trigger aria-pressed="false">{{ t.telimciler.meet }}</button>
        </div>
        <div class="flip-face instructor-face-back" style="background:{{ ins.house_color }};">
          <div>{{ ins.bio }}</div>
          {% if ins.this_month_programs %}<div style="margin-top:8px; font-weight:800;">{{ ins.this_month_programs }}</div>{% endif %}
          <button type="button" class="btn-secondary" data-flip-trigger style="margin-top:12px;">{{ t.telimciler.flipBack }}</button>
        </div>
      </div>
    </div>
    {% endfor %}
  </div>
  {% endif %}
</section>

<section class="container" style="margin-top:36px;">
  <div class="callout" style="background:var(--night); color:var(--cream);">
    <div style="font-family:var(--font-display); font-weight:700; font-size:1.2rem;">{{ t.telimciler.applyTitle }}</div>
    <div style="margin-top:4px; font-weight:700; font-size:.92rem; color:#C9D3E8;">{{ t.telimciler.applyLead }}</div>

    {% if applicationSent %}
    <div class="form-alert success" style="margin-top:16px;">{{ t.telimciler.sent }}</div>
    {% else %}
    {% if applicationError %}<div class="form-alert error" style="margin-top:16px;">{{ t.telimciler.error }}</div>{% endif %}
    <form method="post" action="/{{ lang }}/telimciler/muraciet" style="margin-top:16px;">
      <input type="text" name="website" class="visually-hidden" tabindex="-1" autocomplete="off" aria-hidden="true">
      <div class="field"><label for="apply-name">{{ t.telimciler.formName }}</label><input type="text" id="apply-name" name="name" required></div>
      <div class="field"><label for="apply-phone">{{ t.telimciler.formPhone }}</label><input type="tel" id="apply-phone" name="phone" required></div>
      <div class="field"><label for="apply-message">{{ t.telimciler.formMessage }}</label><textarea id="apply-message" name="message"></textarea></div>
      <button type="submit" class="btn-primary">{{ t.telimciler.send }}</button>
    </form>
    {% endif %}
  </div>
</section>
{% endblock %}
