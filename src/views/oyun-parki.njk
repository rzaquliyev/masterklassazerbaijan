{% extends "layouts/base.njk" %}
{% block body_class %}ground-sky{% endblock %}

{% block title %}{{ t.oyunParki.title }} — {{ t.siteName }}{% endblock %}
{% block meta_description %}{{ t.oyunParki.lead }}{% endblock %}
{% block extra_css %}<link rel="stylesheet" href="/css/oyun-parki.css?v={{ assetV }}">{% endblock %}

{% block content %}
<section class="container page-head">
  <h1>{{ t.oyunParki.title }}</h1>
  <p class="page-lead">{{ t.oyunParki.lead }}</p>
</section>

<section class="container">
  <div class="park-scene" aria-hidden="true" data-replay>
    <span class="park-grass"></span>
    <span class="ferris">
      <span class="ferris-leg"></span><span class="ferris-leg ferris-leg--2"></span>
      <span class="ferris-wheel m-spin" data-anim>
        <span class="ferris-cab" style="--a:0deg; background:var(--orange);"></span>
        <span class="ferris-cab" style="--a:60deg; background:var(--sun);"></span>
        <span class="ferris-cab" style="--a:120deg; background:var(--blue);"></span>
        <span class="ferris-cab" style="--a:180deg; background:var(--pink);"></span>
        <span class="ferris-cab" style="--a:240deg; background:var(--green);"></span>
        <span class="ferris-cab" style="--a:300deg; background:var(--butter);"></span>
      </span>
      <span class="ferris-hub"></span>
    </span>
    <span class="swing-set">
      <span class="swing-bar"></span>
      <span class="swing-leg"></span><span class="swing-leg swing-leg--2"></span>
      <span class="swing-seat m-swing" data-anim><span class="swing-rope"></span><span class="swing-rope swing-rope--2"></span><span class="swing-board clay-sm"></span></span>
      <span class="swing-seat swing-seat--2 m-swing" data-anim style="--d:.5s;"><span class="swing-rope"></span><span class="swing-rope swing-rope--2"></span><span class="swing-board clay-sm" style="background:var(--blue);"></span></span>
    </span>
  </div>
</section>


<section class="container" style="margin-top:30px;">
  <h2>{{ t.oyunParki.moreTitle }}</h2>
  <div class="card-grid cols-2" style="margin-top:14px;" data-stagger>
    <a href="/{{ lang }}/oyun-parki/toplar" data-tilt class="park-tile wide" style="background:var(--green); color:var(--night);">
      <span class="park-tile-icon park-icon-balls" aria-hidden="true"><i></i><i></i><i></i></span>
      <span><span class="park-tile-badge">{{ t.games.newBadge }}</span><span class="park-tile-title">{{ t.games.toplar.title }}</span><span class="park-tile-text">{{ t.games.toplar.tile }}</span></span>
    </a>
    <a href="/{{ lang }}/oyun-parki/fiqur" data-tilt class="park-tile" style="background:var(--pink); color:var(--night);">
      <span class="park-tile-icon park-icon-face clay" aria-hidden="true"><i></i><i></i></span>
      <span><span class="park-tile-badge">{{ t.games.newBadge }}</span><span class="park-tile-title">{{ t.games.fiqur.title }}</span><span class="park-tile-text">{{ t.games.fiqur.tile }}</span></span>
    </a>
    <a href="/{{ lang }}/oyun-parki/qarisdir" data-tilt class="park-tile" style="background:var(--butter); color:var(--night);">
      <span class="park-tile-icon park-icon-mix" aria-hidden="true"><i></i><i></i></span>
      <span><span class="park-tile-badge">{{ t.games.newBadge }}</span><span class="park-tile-title">{{ t.games.qarisdir.title }}</span><span class="park-tile-text">{{ t.games.qarisdir.tile }}</span></span>
    </a>
  </div>
</section>


<section class="container" style="padding-top:30px;">
  <div class="sample-notice" style="background:var(--white); border-radius:var(--radius-md); padding:14px 16px; box-shadow:0 4px 0 var(--card-shadow);">{{ t.oyunParki.privacyNote }}</div>
</section>
{% endblock %}

